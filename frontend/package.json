{
  "name": "selfmall-frontend",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @selfmall/storefront dev",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "prettier": "^3.9.10",
    "typescript": "~5.8.3"
  }
}
