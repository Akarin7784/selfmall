SPRING_PROFILES_ACTIVE=cloud,k8s
SPRING_CONFIG_ADDITIONAL_LOCATION=file:/app/config/
SERVER_PORT=8080
SERVER_SHUTDOWN=graceful
SPRING_LIFECYCLE_TIMEOUT_PER_SHUTDOWN_PHASE=30s
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=65.0 -XX:InitialRAMPercentage=25.0 -XX:+ExitOnOutOfMemoryError -Duser.home=/home/mall
